# Binance API (Spot — Enable Trading)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit API (Spot — торговля)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# Telegram алерты
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
DATABASE_URL=sqlite:///traderbot.db

# SpreadArb
PAPER_TRADING=true          # false = реальные ордера
ARB_SIZE_USDT=10            # размер позиции в USDT ($10 для теста)

# Daily loss limit (в executor.py MAX_DAILY_LOSS)
# При потере >$20 за день — стоп

LOG_LEVEL=INFO
