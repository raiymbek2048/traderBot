# Bybit API (paper trading — testnet или реальный ключ с read-only)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Telegram алерты
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostgreSQL
DATABASE_URL=postgresql://traderbot:password@localhost:5432/traderbot

# Параметры стратегии
SYMBOL=ETHUSDT
LEVERAGE=2
RISK_PER_TRADE=0.015       # 1.5% капитала на сделку
FUNDING_THRESHOLD=0.0005   # 0.05% / 8h — порог сигнала
STOP_LOSS_PCT=0.03         # 3% стоп
TAKE_PROFIT_PCT=0.015      # 1.5% тейк

# Режим
PAPER_TRADING=true
LOG_LEVEL=INFO
