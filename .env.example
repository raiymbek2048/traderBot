# Binance API (Spot — Enable Trading)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bybit API (Spot — торговля)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# Telegram алерты
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
DATABASE_URL=sqlite:///traderbot.db

# ВАЖНО: true = только симуляция, false = реальные ордера (менять только когда готов!)
PAPER_TRADING=true

# SpreadArb (cross-exchange)
ARB_SIZE_USDT=10

# Funding Rate Arb
FUNDING_SIZE_USDT=50        # размер позиции (нужно $500+ на счету)
ENTRY_THRESHOLD=0.0005      # 0.05%/8h — порог входа
EXIT_THRESHOLD=0.0001       # 0.01%/8h — порог выхода

LOG_LEVEL=INFO
